<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # =====================================================
    # 1. STRICT CANONICALIZATION (Force HTTPS + WWW)
    # Defends Against: SEO Penalties, Man-in-the-Middle (MitM) Attacks
    # =====================================================
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^ https://www.%1%{REQUEST_URI} [L,NE,R=301]

    # =====================================================
    # 2. BLOCK EXPLOIT PROBES & MALICIOUS QUERY STRINGS
    # Defends Against: Basic SQLi, XSS, and File Inclusion bots
    # =====================================================
    RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2})
    RewriteRule ^(.*)$ - [F,L]

    # =====================================================
    # 3. BLOCK SENSITIVE FILES (Allowing Let's Encrypt)
    # Defends Against: Source Code / Credentials Leakage
    # =====================================================
    # Allow ACME challenge for automated SSL renewal
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteCond %{SCRIPT_FILENAME} -d [OR]
    RewriteCond %{SCRIPT_FILENAME} -f
    RewriteRule "(^|/)\." - [F]

    # =====================================================
    # 4. HANDLE AUTHORIZATION & TOKENS
    # =====================================================
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # =====================================================
    # 5. REDIRECT TRAILING SLASHES (SEO)
    # =====================================================
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # =====================================================
    # 6. LARAVEL FRONT CONTROLLER
    # =====================================================
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # =====================================================
    # 7. STRIP SERVER SIGNATURES
    # Defends Against: Reconnaissance by attackers (Information Leakage)
    # =====================================================
    Header always unset X-Powered-By
    Header always unset Server
    Header always unset X-Pingback

    # =====================================================
    # 8. AGGRESSIVE SECURITY HEADERS
    # =====================================================
    # Defends Against: MIME-type Confusion Attacks
    Header always set X-Content-Type-Options "nosniff"
    
    # Defends Against: Clickjacking / UI Redressing
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Defends Against: Protocol Downgrade Attacks (HSTS Preload Ready)
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" env=HTTPS
    
    # Defends Against: Cross-Origin Information Leakage via Referrer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Defends Against: Browser Feature Abuse (Locks down hardware access)
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), fullscreen=(self)"

    # Defends Against: Cross-Site Scripting (XSS) & Data Injection
    # NOTE: This is a baseline CSP. You may need to tweak this if you use external CDNs (like Google Fonts).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self'; upgrade-insecure-requests;"
</IfModule>