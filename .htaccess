# ==============================================================================
# SERVER HARDENING & GLOBAL SETTINGS
# ==============================================================================
ServerSignature Off
# Note: ServerTokens and TraceEnable usually belong in httpd.conf, 
# but keep them here if your provider allows override.
TraceEnable Off
Options -Indexes -Multiviews +FollowSymLinks
FileETag None

# ==============================================================================
# REWRITE ENGINE & REDIRECTS (Consolidated)
# ==============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Enforce HTTPS & WWW in a single redirect (Efficiency)
    # If not HTTPS OR not www.u-prepare.com, redirect to the final destination
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^www\.u-prepare\.com$ [NC]
    RewriteRule ^(.*)$ https://www.u-prepare.com/$1 [L,R=301]

    # 2. Handle Authorization Header for Laravel/API
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 3. Security: Block sensitive files/folders
    # Blocks .env, .git, etc., and specific extensions
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(env|git|htaccess|htpasswd|ini|sh|sql|bak|swp|yml|yaml|config|secret|log|composer\.(json|lock)|package\.json)$ - [F,L,NC]

    # 4. Remove Trailing Slashes (If not a directory)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 5. Laravel Front Controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ==============================================================================
# SECURITY HEADERS
# ==============================================================================
<IfModule mod_headers.c>
    # Remove information leakage headers
    Header always unset X-Powered-By
    Header always unset X-AspNet-Version
    
    # Secure Headers
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # Content Security Policy (Optimized)
    # Added 'self' for styles and scripts to ensure local assets load.
    Header always set Content-Security-Policy "default-src 'self' https://www.u-prepare.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://ui-avatars.com; frame-src https://www.google.com https://www.gstatic.com; connect-src 'self'; font-src 'self' https://fonts.gstatic.com;"

    # Cookie Security: Ensure all cookies are Secure, HttpOnly, and Strict
    # This regex avoids doubling flags if Laravel already sends them.
    Header always edit Set-Cookie "^(.*)((?i);\s*Secure)?$" "$1; Secure; HttpOnly; SameSite=Strict"
</IfModule>

# ==============================================================================
# FILE ACCESS & CACHING
# ==============================================================================
# Block access to system files (Redundancy for non-mod_rewrite environments)
<FilesMatch "^(\.env|artisan|composer\.json|package\.json|vite\.config\.js|webpack\.mix\.js)$">
    Require all denied
</FilesMatch>

# Cache Control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Do not cache dynamic content
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Force no-cache for sensitive file types
    <FilesMatch "\.(php|json|xml|env|config)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>